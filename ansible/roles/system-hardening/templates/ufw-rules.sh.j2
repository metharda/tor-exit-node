#!/bin/bash

set -euo pipefail

ufw --force reset

ufw default deny incoming
ufw default allow outgoing
ufw default deny forward

ufw allow in on lo
ufw allow out on lo

ufw allow 22/tcp comment 'SSH'

ufw allow 41641/udp comment 'Tailscale'

ufw allow from 10.0.0.0/8 to any port 9100 comment 'Node Exporter from private networks'
ufw allow from 172.16.0.0/12 to any port 9100 comment 'Node Exporter from private networks'
ufw allow from 192.168.0.0/16 to any port 9100 comment 'Node Exporter from private networks'

ufw allow in on tailscale0 to any
ufw allow out on tailscale0 from any

ufw allow out 53 comment 'DNS'
ufw allow out 80/tcp comment 'HTTP'
ufw allow out 443/tcp comment 'HTTPS'
ufw allow out 123/udp comment 'NTP'

ufw deny out on eth0 from 100.64.0.0/10 comment 'Block Tailscale range direct exit'

echo "UFW rules configured successfully"