# Tor client for the Tailscale exit node (runs with host networking).
# This is not a relay: no ORPort, no DirPort, no descriptor.

# SOCKS only on loopback.
SocksPort 127.0.0.1:9050
SocksPolicy accept 127.0.0.0/8
SocksPolicy reject *

# Transparent proxy and DNS. They bind all addresses because iptables REDIRECTs
# client traffic to the tailscale0 address; the firewall only accepts these
# ports from tailscale0 and lo. DNSPort is UDP; test it with dig, not nc.
TransPort 0.0.0.0:9040
DNSPort 0.0.0.0:9053

# Hostnames resolved through DNSPort (including .onion) get an address from this
# range; connections to it through TransPort are mapped back by Tor.
VirtualAddrNetworkIPv4 10.192.0.0/10
AutomapHostsOnResolve 1

DataDirectory /var/lib/tor
RunAsDaemon 0
Log notice stdout

ClientOnly 1
ControlPort 0
ORPort 0
DirPort 0
PublishServerDescriptor 0
