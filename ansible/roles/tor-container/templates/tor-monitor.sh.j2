#!/bin/bash

# Tor container watchdog. Runs in the foreground under tor-monitor.service.
# Health = a real request through Tor's SOCKS port. The container is only
# restarted after several failures in a row, and not again during the grace
# period that follows a restart (Tor needs time to bootstrap).

set -uo pipefail

readonly CHECK_INTERVAL=60
readonly FAILURES_BEFORE_RESTART=5
readonly RESTART_GRACE=300

log_message() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

tor_healthy() {
	curl -sf --max-time 30 --socks5-hostname 127.0.0.1:9050 https://check.torproject.org/api/ip |
		grep -q '"IsTor":true'
}

restart_tor_container() {
	log_message "Restarting Tor container"
	if ! docker compose --project-directory /opt/tor-proxy up -d --force-recreate; then
		log_message "ERROR: docker compose up failed"
	fi
}

main() {
	local failures=0
	local last_restart=0

	log_message "Starting Tor container monitoring"
	while true; do
		if tor_healthy; then
			if [[ $failures -gt 0 ]]; then
				log_message "Tor is healthy again after $failures failed checks"
			fi
			failures=0
		else
			failures=$((failures + 1))
			log_message "WARNING: Tor health check failed ($failures/$FAILURES_BEFORE_RESTART)"
			if [[ $failures -ge $FAILURES_BEFORE_RESTART ]] &&
				[[ $(($(date +%s) - last_restart)) -ge $RESTART_GRACE ]]; then
				restart_tor_container
				last_restart=$(date +%s)
				failures=0
			fi
		fi
		sleep "$CHECK_INTERVAL"
	done
}

main "$@"
