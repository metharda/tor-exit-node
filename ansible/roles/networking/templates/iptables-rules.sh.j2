#!/bin/bash
# Transparent Tor proxy rules for the exit node.
#
# Only the project's own chains (TORPROXY_*) are replaced; the built-in chains
# are never flushed. Each table is loaded with one iptables-restore --noflush,
# so a chain is never seen half-filled, and every jump is added once, so
# running this script again gives the same ruleset.
#
#   nat    PREROUTING -i tailscale0 -> TORPROXY_PRE  client TCP -> TransPort, UDP 53 -> DNSPort
#   nat    OUTPUT                   -> TORPROXY_OUT  the VM's own TCP -> TransPort, UDP 53 -> DNSPort
#   filter INPUT                    -> TORPROXY_IN   Tor ports only from tailscale0 and lo
#   filter OUTPUT                   -> TORPROXY_EGR  the VM's own non-Tor traffic is dropped
#   filter FORWARD                  -> TORPROXY_FWD  nothing is forwarded (ip_forward stays 0)

set -euo pipefail

readonly TOR_UID={{ tor_uid }}
readonly TRANS_PORT=9040
readonly DNS_PORT=9053
readonly SOCKS_PORT=9050
readonly TS_IF=tailscale0
# tailscaled marks its own sockets (control, DERP, WireGuard) with this fwmark.
readonly TS_BYPASS_MARK=0x80000/0xff0000

# Insert a jump at the top of a built-in chain unless it is already there.
ensure_jump() {
	local cmd=$1 table=$2 parent=$3
	shift 3
	"$cmd" -w -t "$table" -C "$parent" "$@" 2>/dev/null || "$cmd" -w -t "$table" -I "$parent" 1 "$@"
}

iptables-restore -w --noflush <<RULES
*nat
:TORPROXY_PRE - [0:0]
-A TORPROXY_PRE -p udp --dport 53 -j REDIRECT --to-ports $DNS_PORT
# Connections to the VM itself (SSH over the tailnet, peerapi/MagicDNS) stay local.
-A TORPROXY_PRE -p tcp -m addrtype --dst-type LOCAL -j RETURN
# Everything else, including 10.192.0.0/10 automap addresses and private ranges, goes into Tor.
-A TORPROXY_PRE -p tcp --syn -j REDIRECT --to-ports $TRANS_PORT
:TORPROXY_OUT - [0:0]
-A TORPROXY_OUT -m owner --uid-owner $TOR_UID -j RETURN
-A TORPROXY_OUT -p udp --dport 53 -j REDIRECT --to-ports $DNS_PORT
-A TORPROXY_OUT -m mark --mark $TS_BYPASS_MARK -j RETURN
-A TORPROXY_OUT -m addrtype --dst-type LOCAL -j RETURN
-A TORPROXY_OUT -p tcp --syn -j REDIRECT --to-ports $TRANS_PORT
COMMIT
*filter
:TORPROXY_IN - [0:0]
-A TORPROXY_IN -i lo -j RETURN
-A TORPROXY_IN -i $TS_IF -p tcp --dport $TRANS_PORT -j RETURN
-A TORPROXY_IN -i $TS_IF -p udp --dport $DNS_PORT -j RETURN
-A TORPROXY_IN -p tcp -m multiport --dports $TRANS_PORT,$SOCKS_PORT,$DNS_PORT -j DROP
-A TORPROXY_IN -p udp --dport $DNS_PORT -j DROP
:TORPROXY_EGR - [0:0]
-A TORPROXY_EGR -o lo -j RETURN
# Replies to connections opened from outside (SSH on the management interface, tailnet clients).
-A TORPROXY_EGR -m conntrack --ctstate ESTABLISHED,RELATED --ctdir REPLY -j RETURN
-A TORPROXY_EGR -m owner --uid-owner $TOR_UID -j RETURN
-A TORPROXY_EGR -m mark --mark $TS_BYPASS_MARK -j RETURN
# DHCP on the libvirt network.
-A TORPROXY_EGR -p udp --sport 68 --dport 67 -j RETURN
-A TORPROXY_EGR -j DROP
:TORPROXY_FWD - [0:0]
-A TORPROXY_FWD -j DROP
COMMIT
RULES

ensure_jump iptables nat PREROUTING -i "$TS_IF" -j TORPROXY_PRE
ensure_jump iptables nat OUTPUT -j TORPROXY_OUT
ensure_jump iptables filter INPUT -j TORPROXY_IN
ensure_jump iptables filter OUTPUT -j TORPROXY_EGR
ensure_jump iptables filter FORWARD -j TORPROXY_FWD
iptables -w -P FORWARD DROP

# IPv6: nothing in or out except loopback.
ip6tables-restore -w --noflush <<RULES
*filter
:TORPROXY6_IN - [0:0]
-A TORPROXY6_IN -i lo -j ACCEPT
:TORPROXY6_OUT - [0:0]
-A TORPROXY6_OUT -o lo -j ACCEPT
COMMIT
RULES
ensure_jump ip6tables filter INPUT -j TORPROXY6_IN
ensure_jump ip6tables filter OUTPUT -j TORPROXY6_OUT
ip6tables -w -P INPUT DROP
ip6tables -w -P OUTPUT DROP
ip6tables -w -P FORWARD DROP

# All client traffic is REDIRECTed to local ports, so nothing needs forwarding.
sysctl -q -w net.ipv4.ip_forward=0
sysctl -q -w net.ipv6.conf.all.forwarding=0

echo "Transparent proxy rules applied (Tor UID $TOR_UID)"
