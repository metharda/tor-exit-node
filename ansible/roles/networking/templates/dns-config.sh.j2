#!/bin/bash

# Points system DNS at 127.0.0.1. The firewall redirects UDP 53 to Tor's
# DNSPort, so no forwarder or public resolver is involved.

set -euo pipefail

if [ ! -f /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg ]; then
	echo "network: {config: disabled}" >/etc/cloud/cloud.cfg.d/99-disable-network-config.cfg
fi

if systemctl is-enabled --quiet systemd-resolved 2>/dev/null || systemctl is-active --quiet systemd-resolved; then
	systemctl disable --now systemd-resolved
	echo "changed: systemd-resolved disabled"
fi

desired="nameserver 127.0.0.1
options edns0 trust-ad"

if [ -L /etc/resolv.conf ] || [ "$(cat /etc/resolv.conf 2>/dev/null)" != "$desired" ]; then
	rm -f /etc/resolv.conf
	printf '%s\n' "$desired" >/etc/resolv.conf
	chmod 644 /etc/resolv.conf
	echo "changed: /etc/resolv.conf points to 127.0.0.1"
fi

echo "DNS uses 127.0.0.1 (redirected to Tor DNSPort 9053)"
